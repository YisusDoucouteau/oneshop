APP_NAME=OneShop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sistema.ejemplo.com
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
