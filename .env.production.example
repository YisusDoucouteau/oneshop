DB_USERNAME=oneshop
DB_PASSWORD=CAMBIAR_CONTRASENA_BASE_DE_DATOS

MYSQL_DATABASE=oneshop
MYSQL_USER=oneshop
MYSQL_PASSWORD=CAMBIAR_CONTRASENA_BASE_DE_DATOS
MYSQL_ROOT_PASSWORD=CAMBIAR_CONTRASENA_ROOT

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

